{
  "name": "@creatorcore/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CreatorCore platform backend foundation (docs/adr/0002-backend-api-architecture.md) — health/ready endpoints only, no product CRUD yet.",
  "license": "UNLICENSED",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./services/credential-service": {
      "types": "./dist/services/credential-service.d.ts",
      "default": "./dist/services/credential-service.js"
    },
    "./services/discord-validator": {
      "types": "./dist/services/discord-validator.d.ts",
      "default": "./dist/services/discord-validator.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "creatorcore": {
    "testGates": {
      "unit": true,
      "integration": true,
      "e2e": false
    }
  },
  "dependencies": {
    "@creatorcore/config": "workspace:*",
    "@creatorcore/db": "workspace:*",
    "@creatorcore/logger": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-auth": "1.7.4",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
