# CreatorCore — environment variable names only.
#
# This file documents *names*, not values. No secrets belong in this file or
# in any committed file. See docs/DEVELOPMENT.md for environment separation
# rules (local/test/staging/production must never share credentials or data).
#
# Do not add future OAuth/bot-token/KMS variables here until the Phase that
# actually implements them needs them (docs/adr/ lists what's locked vs.
# implemented) — see docs/ARCHITECTURE.md's Phase 2 status note.
#
# For a real local .env, don't hand-fill this file — run the bootstrap
# script instead (docs/DEVELOPMENT.md's "Local environment setup" section):
#   powershell -ExecutionPolicy Bypass -File scripts/setup-local-env.ps1
# It fills in every value below marked AUTO-GENERATED with a real,
# independent, cryptographically random value and leaves every value marked
# MANUAL blank with instructions on where to get it. This file stays
# documentation-only regardless — it is never edited to hold real values.

# --- Database (MySQL 8.0+ — locked engine, see docs/DATABASE_RULES.md) ---
# Loaded only by apps/api via @creatorcore/config + @creatorcore/db.
# apps/web and apps/worker must never receive this (docs/adr/0002).
# MANUAL — your own local MySQL 8.0+ instance.
# DATABASE_URL=mysql://username:password@host:3306/database

# --- apps/api ---
# NODE_ENV=development
# LOG_LEVEL=info
# PORT=8787
# AUTO-GENERATED — worker internal service-auth signing key (docs/adr/0011)
# — apps/api only, never provisioned to apps/web/apps/worker. High-entropy,
# >=32 characters.
# WORKER_TOKEN_SIGNING_KEY=
# WORKER_TOKEN_SIGNING_KEY_VERSION=1
# Optional — only set during a key-rotation cutover; never fabricated for a
# fresh install.
# WORKER_TOKEN_SIGNING_KEY_PREVIOUS=
# AUTO-GENERATED — bot-credential envelope encryption key (docs/adr/0007) —
# canonical base64url, exactly 32 decoded bytes. apps/api only.
# BOT_CREDENTIAL_ENCRYPTION_KEY=
# BOT_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Optional — rotation only; never fabricated for a fresh install.
# BOT_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS=
# BOT_CREDENTIAL_ENCRYPTION_KEY_PREVIOUS_VERSION=

# --- apps/api: Phase 5 — Better Auth + Discord OAuth (docs/adr/0003) ---
# apps/api only; none of these reach apps/web or apps/worker.
# AUTO-GENERATED — High-entropy, >=32 characters.
# BETTER_AUTH_SECRET=
# The public web-facing origin — Better Auth's baseURL (redirect_uri +
# cookie host binding) and the CSRF origin-check allowlist both use this
# single value. Never apps/api's own address.
# WEB_APP_ORIGIN=http://localhost:3000
# MANUAL — Discord Developer Portal -> your CreatorCore application -> OAuth2.
# DISCORD_CLIENT_ID=
# MANUAL — Discord Developer Portal -> your CreatorCore application -> OAuth2.
# See docs/DEVELOPMENT.md for the exact redirect/callback URL to register
# alongside it.
# DISCORD_CLIENT_SECRET=
# AUTO-GENERATED — Discord OAuth-token envelope encryption key (Amendment 1)
# — a key domain wholly independent of BOT_CREDENTIAL_ENCRYPTION_KEY/
# WORKER_TOKEN_SIGNING_KEY/BETTER_AUTH_SECRET/DISCORD_CLIENT_SECRET.
# Canonical base64url, 32 bytes.
# DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY=
# DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY_VERSION=1
# Optional — rotation only; never fabricated for a fresh install.
# DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# DISCORD_OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=

# --- apps/worker ---
# NODE_ENV=development
# LOG_LEVEL=info
# AUTO-GENERATED — a stable UUID, generated once and never regenerated on
# restart. Note: the ID alone does not let the worker complete its
# bootstrap exchange (docs/adr/0011) — apps/api only accepts a worker ID
# with a matching row provisioned in the database
# (packages/db's provisionWorker(), not yet wired to any script). Until
# then, apps/worker runs its heartbeat only, exactly as it does today with
# WORKER_ID unset.
# WORKER_ID=
# API_BASE_URL=http://localhost:8787

# --- apps/web (browser-safe only — never a server secret) ---
# NODE_ENV=development
# NEXT_PUBLIC_APP_NAME=CreatorCore

# --- apps/web: server-only (Phase 5) — never NEXT_PUBLIC_, never imported
# from a "use client" component (@creatorcore/config/web-server) ---
# apps/api's internal (non-public) address, used only in Server Actions/
# Route Handlers to forward the session cookie/Origin header server-to-server.
# API_INTERNAL_URL=http://localhost:8787
