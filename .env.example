# CreatorCore — environment variable names only.
#
# This file documents *names*, not values. No secrets belong in this file or
# in any committed file. No product framework is implied by these entries —
# they exist because the database engine is [LOCKED] (see docs/DATABASE_RULES.md);
# everything else here is a placeholder shape, not an approved architecture.
#
# See docs/DEVELOPMENT.md for environment separation rules (local/test/staging/production
# must never share credentials or data).

# --- Database (MySQL 8.0+ — locked engine, see docs/DATABASE_RULES.md) ---
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_CONNECTION_LIMIT=

# --- Application runtime (names only — no framework selected yet) ---
# NODE_ENV=development
# LOG_LEVEL=info

# Additional variables (Discord app credentials, session secrets, encryption
# keys, etc.) will be defined when the corresponding Phase 1 architecture
# decision is made. Do not add framework-specific variables speculatively.
