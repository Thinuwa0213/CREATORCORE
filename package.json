{
  "name": "creatorcore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CreatorCore engineering foundation (Phase 0) — infrastructure only, no product code yet.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "test": "node scripts/check-test-gate.mjs unit",
    "test:integration": "node scripts/check-test-gate.mjs integration",
    "test:e2e": "node scripts/check-test-gate.mjs e2e",
    "build": "node scripts/check-build-gate.mjs",
    "audit": "pnpm audit --audit-level=high",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "env:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local-env.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
